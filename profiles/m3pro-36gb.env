# MacBook Pro, M3 Pro, 36 GB unified memory.
#
# Roughly 26-27 GB is usable for the model. qwen3-coder:30b is ~19 GB on disk
# and is tuned for code; with a q8_0 KV cache a 64k context adds ~3 GB.
# qwen3.5:27b (17-20 GB) is the general-purpose alternative.
MODEL="qwen3-coder:30b"
CONTEXT="65536"
KV_CACHE="q8_0"
FALLBACK_MODEL="qwen3.5:27b"
